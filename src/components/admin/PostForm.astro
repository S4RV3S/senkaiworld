---
import type { CmsPost } from "../../lib/cms/posts";

interface Props {
  post?: CmsPost | null;
}

const { post = null } = Astro.props;
const isEdit = !!post;
---

<div class="mx-auto max-w-2xl px-6 py-8">
  <a href="/admin" class="text-sm text-slate-400 hover:text-slate-300">&larr; Dashboard</a>
  <h1 class="mt-3 mb-8 text-2xl font-bold text-white">{isEdit ? "Edit Post" : "New Post"}</h1>

  <div class="space-y-6">
    <div>
      <label for="title" class="mb-1.5 block text-sm text-slate-400">Title</label>
      <input
        type="text"
        id="title"
        value={post?.title ?? ""}
        placeholder="e.g. Blue Lock Season 3: Release Date Confirmed"
        class="w-full rounded-lg border border-slate-800 bg-slate-900 px-3 py-2.5 text-sm text-white outline-none focus:border-violet-500"
      />
    </div>

    <div>
      <label for="category" class="mb-1.5 block text-sm text-slate-400">Category</label>
      <select
        id="category"
        class="w-full rounded-lg border border-slate-800 bg-slate-900 px-3 py-2.5 text-sm text-white outline-none focus:border-violet-500"
      >
        <option value="news" selected={post?.category === "news" || !post}>News</option>
        <option value="reviews" selected={post?.category === "reviews"}>Reviews</option>
        <option value="rankings" selected={post?.category === "rankings"}>Rankings</option>
      </select>
    </div>

    <div id="scoreField" class="hidden">
      <label for="score" class="mb-1.5 block text-sm text-slate-400">Score (out of 10)</label>
      <input
        type="number"
        id="score"
        min="0"
        max="10"
        step="0.1"
        value={post?.score ?? ""}
        class="w-full rounded-lg border border-slate-800 bg-slate-900 px-3 py-2.5 text-sm text-white outline-none focus:border-violet-500"
      />
    </div>

    <div>
      <label class="mb-1.5 block text-sm text-slate-400">Thumbnail</label>
      <div class="flex items-center gap-4">
        <img
          id="thumbPreview"
          src={post?.thumbnail_url ?? ""}
          class={`h-20 w-20 rounded-lg border border-slate-800 bg-slate-900 object-cover ${post?.thumbnail_url ? "" : "hidden"}`}
        />
        <label
          for="thumbInput"
          class="cursor-pointer rounded-lg border border-slate-800 bg-slate-900 px-3.5 py-2 text-sm text-slate-300 hover:border-slate-700"
        >
          Upload image
        </label>
        <input type="file" id="thumbInput" accept="image/*" class="hidden" />
        <span id="uploadStatus" class="text-sm text-slate-500"></span>
      </div>
    </div>

    <div>
      <label for="excerpt" class="mb-1.5 block text-sm text-slate-400">Excerpt</label>
      <textarea
        id="excerpt"
        placeholder="Short teaser shown on cards — leave blank to auto-generate from the content"
        class="min-h-[70px] w-full resize-y rounded-lg border border-slate-800 bg-slate-900 px-3 py-2.5 text-sm text-white outline-none focus:border-violet-500"
      >{post?.excerpt ?? ""}</textarea>
    </div>

    <div>
      <label for="seoTitle" class="mb-1.5 block text-sm text-slate-400">SEO title</label>
      <input
        type="text"
        id="seoTitle"
        value={post?.seo_title ?? ""}
        placeholder="Defaults to the title above if left blank"
        class="w-full rounded-lg border border-slate-800 bg-slate-900 px-3 py-2.5 text-sm text-white outline-none focus:border-violet-500"
      />
    </div>

    <div>
      <label for="seoDescription" class="mb-1.5 block text-sm text-slate-400">SEO description</label>
      <textarea
        id="seoDescription"
        placeholder="1-2 sentence summary shown in search results (~150-160 characters)"
        class="min-h-[70px] w-full resize-y rounded-lg border border-slate-800 bg-slate-900 px-3 py-2.5 text-sm text-white outline-none focus:border-violet-500"
      >{post?.seo_description ?? ""}</textarea>
    </div>

    <div>
      <label class="mb-1.5 block text-sm text-slate-400">Content</label>
      <div id="editor" class="min-h-[280px] rounded-b-lg bg-white text-slate-900" set:html={post?.content_html ?? ""} />
    </div>

    <div class="flex gap-3 pt-2">
      <button
        id="saveDraftBtn"
        class="rounded-lg border border-slate-800 bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:border-slate-700"
      >
        Save draft
      </button>
      <button
        id="publishBtn"
        class="rounded-lg bg-violet-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-violet-500"
      >
        Publish
      </button>
    </div>
    <p id="formMsg" class="hidden text-sm"></p>
  </div>
</div>

<link href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.min.css" rel="stylesheet" />
<style>
  .ql-toolbar.ql-snow {
    border-radius: 0.5rem 0.5rem 0 0;
    background: #1e293b;
    border-color: #1e293b !important;
  }
  .ql-toolbar.ql-snow .ql-stroke {
    stroke: #e2e8f0;
  }
  .ql-toolbar.ql-snow .ql-fill {
    fill: #e2e8f0;
  }
  .ql-toolbar.ql-snow .ql-picker-label {
    color: #e2e8f0;
  }
  .ql-container.ql-snow {
    border-color: #1e293b !important;
  }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js"></script>
<script define:vars={{ isEdit, postId: post?.id ?? null, initialCategory: post?.category ?? "news" }}>
  // The Quill CDN <script> above loads async relative to this one in some
  // dev/hydration timings, so wait for it instead of assuming it's ready.
  function whenQuillReady(callback) {
    if (typeof window.Quill === "function") {
      callback(window.Quill);
    } else {
      setTimeout(() => whenQuillReady(callback), 30);
    }
  }

  whenQuillReady(function (Quill) {
  const quill = new Quill("#editor", {
    theme: "snow",
    placeholder: "Write the article here...",
    modules: {
      toolbar: [
        [{ header: [2, 3, false] }],
        ["bold", "italic", "underline"],
        ["link", "image"],
        [{ list: "ordered" }, { list: "bullet" }],
        ["blockquote", "clean"],
      ],
    },
  });

  const categorySelect = document.getElementById("category");
  const scoreField = document.getElementById("scoreField");

  function syncScoreField() {
    scoreField.classList.toggle("hidden", categorySelect.value !== "reviews");
  }
  categorySelect.addEventListener("change", syncScoreField);
  syncScoreField();

  let thumbnailUrl = document.getElementById("thumbPreview").getAttribute("src") || "";
  const thumbInput = document.getElementById("thumbInput");
  const thumbPreview = document.getElementById("thumbPreview");
  const uploadStatus = document.getElementById("uploadStatus");

  thumbInput.addEventListener("change", async () => {
    const file = thumbInput.files?.[0];
    if (!file) return;
    uploadStatus.textContent = "Uploading...";
    const formData = new FormData();
    formData.append("file", file);
    const res = await fetch("/api/upload", { method: "POST", body: formData });
    const data = await res.json();
    if (res.ok) {
      thumbnailUrl = data.url;
      thumbPreview.src = data.url;
      thumbPreview.classList.remove("hidden");
      uploadStatus.textContent = "Uploaded";
    } else {
      uploadStatus.textContent = data.error || "Upload failed";
    }
  });

  function showMsg(text, isError) {
    const msg = document.getElementById("formMsg");
    msg.textContent = text;
    msg.className = isError ? "text-sm text-red-400" : "text-sm text-green-400";
  }

  async function savePost(status) {
    const title = document.getElementById("title").value.trim();
    if (!title) {
      showMsg("Title is required.", true);
      return;
    }
    const contentHtml = quill.root.innerHTML;

    const payload = {
      title,
      category: categorySelect.value,
      thumbnailUrl,
      excerpt: document.getElementById("excerpt").value.trim(),
      score: document.getElementById("score").value ? Number(document.getElementById("score").value) : null,
      seoTitle: document.getElementById("seoTitle").value.trim(),
      seoDescription: document.getElementById("seoDescription").value.trim(),
      contentHtml,
      status,
    };

    const res = await fetch(isEdit ? `/api/posts/${postId}` : "/api/posts", {
      method: isEdit ? "PUT" : "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      window.location.href = "/admin";
    } else {
      const data = await res.json().catch(() => ({}));
      showMsg(data.error || "Something went wrong.", true);
    }
  }

  document.getElementById("saveDraftBtn").addEventListener("click", () => savePost("draft"));
  document.getElementById("publishBtn").addEventListener("click", () => savePost("published"));
  }); // end whenQuillReady
</script>
